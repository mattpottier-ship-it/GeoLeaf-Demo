{
    "id": "zones",
    "label": "Zones (démo édition)",
    "zIndex": 42,
    "geometry": "polygon",
    "geometryType": "polygon",
    "enableEdition": true,
    "enableEditionFull": true,
    "editableGeometryTypes": ["Polygon"],
    "formSchema": [
        { "id": "nom", "type": "text", "label": "Nom de la zone", "required": true },
        {
            "id": "categorie",
            "type": "dropdown",
            "label": "Catégorie",
            "options": [
                { "value": "protegee", "label": "Protégée" },
                { "value": "amenagement", "label": "Aménagement" },
                { "value": "etude", "label": "Étude" }
            ]
        },
        { "id": "surface_ha", "type": "number", "label": "Surface (ha)", "min": 0 },
        { "id": "description", "type": "longtext", "label": "Description", "rows": 4 }
    ],
    "interactiveShape": true,
    "data": {
        "directory": "data",
        "file": "zones.geojson"
    },
    "styles": {
        "directory": "styles",
        "default": "defaut.json",
        "available": [{ "id": "defaut", "label": "défaut", "file": "defaut.json" }]
    },
    "tooltip": {
        "mode": "hover",
        "fields": [{ "type": "text", "field": "properties.nom" }]
    },
    "popup": {
        "enabled": true,
        "fields": [
            { "type": "text", "field": "properties.nom", "variant": "title" },
            { "type": "text", "label": "Catégorie", "field": "properties.categorie" },
            { "type": "text", "label": "Surface (ha)", "field": "properties.surface_ha" }
        ]
    },
    "sidepanelConfig": {
        "enabled": true,
        "detailLayout": [
            { "type": "badge", "label": "Catégorie", "field": "properties.categorie" },
            { "type": "text", "label": "Surface (ha)", "field": "properties.surface_ha" },
            { "type": "longtext", "label": "Description", "field": "properties.description" }
        ]
    }
}
