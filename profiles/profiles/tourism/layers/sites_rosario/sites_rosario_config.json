{
    "id": "sites_rosario",
    "label": "Sites touristiques – Rosario",
    "zIndex": 97,
    "geometry": "point",
    "geometryType": "point",
    "enableEdition": true,
    "enableEditionFull": true,
    "editableGeometryTypes": ["Point"],
    "formSchema": [
        { "id": "title", "type": "text", "label": "Titre", "required": true },
        { "id": "description", "type": "longtext", "label": "Description courte", "rows": 3 },
        {
            "id": "description_longue",
            "type": "longtext",
            "label": "Description détaillée",
            "rows": 6
        },
        { "id": "adresse", "type": "text", "label": "Adresse" },
        {
            "id": "statut",
            "type": "dropdown",
            "label": "Statut",
            "options": [
                { "value": "Ouvert", "label": "Ouvert" },
                { "value": "Fermé", "label": "Fermé" },
                { "value": "Temporairement fermé", "label": "Temporairement fermé" }
            ]
        },
        {
            "id": "mots_cles",
            "type": "tags",
            "label": "Mots-clés",
            "options": [
                { "value": "patrimoine", "label": "Patrimoine" },
                { "value": "histoire", "label": "Histoire" },
                { "value": "culture", "label": "Culture" },
                { "value": "nature", "label": "Nature" },
                { "value": "gratuit", "label": "Gratuit" },
                { "value": "enfants", "label": "Enfants" }
            ]
        },
        { "id": "services", "type": "list", "label": "Services disponibles", "maxItems": 12 },
        {
            "id": "horaires",
            "type": "table",
            "label": "Horaires d'ouverture",
            "columns": [
                { "key": "jour", "label": "Jour" },
                { "key": "horaire", "label": "Horaire" }
            ]
        },
        { "id": "site_web", "type": "url", "label": "Site web" },
        {
            "id": "photo_principale",
            "type": "image",
            "label": "Photo principale",
            "uploadEndpoint": "/api/upload",
            "maxSizeMb": 5
        },
        {
            "id": "galerie",
            "type": "gallery",
            "label": "Galerie photos",
            "uploadEndpoint": "/api/upload",
            "maxCount": 8,
            "maxSizeMb": 5
        }
    ],
    "imageUploadEndpoint": "/api/upload",
    "interactiveShape": true,
    "showIconsOnMap": true,
    "data": {
        "directory": "data",
        "file": "sites_rosario.geojson"
    },
    "styles": {
        "directory": "styles",
        "default": "defaut.json",
        "available": [
            {
                "id": "defaut",
                "label": "défaut",
                "file": "defaut.json"
            }
        ]
    },
    "tooltip": {
        "mode": "hover",
        "fields": [
            {
                "type": "text",
                "field": "properties.title"
            }
        ]
    },
    "popup": {
        "enabled": true,
        "fields": [
            {
                "type": "text",
                "field": "properties.title",
                "variant": "title"
            },
            {
                "type": "text",
                "label": "Adresse",
                "field": "properties.adresse"
            },
            {
                "type": "text",
                "label": "Statut",
                "field": "properties.statut"
            }
        ]
    },
    "sidepanelConfig": {
        "enabled": true,
        "detailLayout": [
            {
                "type": "text",
                "label": "Adresse",
                "field": "properties.adresse"
            },
            {
                "type": "longtext",
                "label": "Description détaillée",
                "field": "properties.description_longue"
            },
            {
                "type": "list",
                "label": "Services disponibles",
                "field": "properties.services"
            },
            {
                "type": "tags",
                "label": "Mots-clés",
                "field": "properties.mots_cles",
                "options": [
                    { "value": "patrimoine", "label": "Patrimoine" },
                    { "value": "histoire", "label": "Histoire" },
                    { "value": "nature", "label": "Nature" },
                    { "value": "culture", "label": "Culture" },
                    { "value": "gratuit", "label": "Gratuit" },
                    { "value": "enfants", "label": "Enfants" }
                ]
            },
            {
                "type": "table",
                "label": "Horaires d'ouverture",
                "field": "properties.horaires",
                "columns": [
                    { "key": "jour", "label": "Jour" },
                    { "key": "horaire", "label": "Horaire" }
                ]
            },
            {
                "type": "link",
                "label": "Site web",
                "field": "properties.site_web"
            },
            {
                "type": "badge",
                "label": "Statut",
                "field": "properties.statut"
            },
            {
                "type": "image",
                "label": "Photo principale",
                "field": "properties.photo_principale"
            },
            {
                "type": "gallery",
                "label": "Galerie photos",
                "field": "properties.galerie",
                "maxCount": 8,
                "maxSizeMb": 5
            }
        ]
    }
}
